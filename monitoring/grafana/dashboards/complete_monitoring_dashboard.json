{
  "title": "Host and Container Monitoring",
  "uid": "host_container_monitoring",
  "schemaVersion": 42,
  "version": 1,
  "timezone": "browser",
  "editable": true,
  "hideControls": false,
  "panels": [
    {
      "type": "gauge",
      "title": "Host CPU Usage",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "100 - (avg(rate(node_cpu_seconds_total{job=\"node-exporter\",mode=\"idle\"}[2m])) * 100)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        }
      }
    },
    {
      "type": "gauge",
      "title": "Host RAM Usage",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "((node_memory_MemTotal_bytes{job=\"node-exporter\"} - node_memory_MemAvailable_bytes{job=\"node-exporter\"}) / node_memory_MemTotal_bytes{job=\"node-exporter\"}) * 100",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Host Filesystem Usage",
      "description": "Root filesystem only (mountpoint=\"/\", host root remapped from /host/root).",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "100 * (1 - (sum(node_filesystem_avail_bytes{job=\"node-exporter\",mountpoint=\"/\",fstype=~\"ext4|xfs|btrfs|overlay|zfs\"}) / sum(node_filesystem_size_bytes{job=\"node-exporter\",mountpoint=\"/\",fstype=~\"ext4|xfs|btrfs|overlay|zfs\"})))",
          "legendFormat": "root filesystem used",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Host Network Traffic",
      "description": "Physical interfaces only \u2014 loopback and docker/veth bridges excluded.",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(node_network_receive_bytes_total{job=\"node-exporter\",device!~\"lo|veth.+|docker.+|br-.+|cali.+|flannel.+|cni.+\"}[2m]))",
          "legendFormat": "receive",
          "refId": "A"
        },
        {
          "expr": "sum(rate(node_network_transmit_bytes_total{job=\"node-exporter\",device!~\"lo|veth.+|docker.+|br-.+|cali.+|flannel.+|cni.+\"}[2m]))",
          "legendFormat": "transmit",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        }
      }
    },
    {
      "type": "gauge",
      "title": "Container CPU Usage",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 6,
        "h": 8
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by(container_name) (rate(docker_container_cpu_usage_total{job=\"telegraf\",cpu=\"cpu-total\",container_name=~\"$container\"}[2m])) / 1e9 / scalar(count(count by(cpu) (node_cpu_seconds_total{job=\"node-exporter\",mode=\"idle\"}))) * 100",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        }
      }
    },
    {
      "type": "gauge",
      "title": "Container RAM Usage",
      "gridPos": {
        "x": 6,
        "y": 16,
        "w": 6,
        "h": 8
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "docker_container_mem_usage{job=\"telegraf\",container_name=~\"$container\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 8589934592
              }
            ]
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Container Disk I/O",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by(container_name) (rate(docker_container_blkio_io_service_bytes_recursive_read{job=\"telegraf\",container_name=~\"$container\"}[2m]))",
          "legendFormat": "read {{container_name}}",
          "refId": "A"
        },
        {
          "expr": "sum by(container_name) (rate(docker_container_blkio_io_service_bytes_recursive_write{job=\"telegraf\",container_name=~\"$container\"}[2m]))",
          "legendFormat": "write {{container_name}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        }
      },
      "description": "Per-container disk read/write throughput. (Per-container writable-layer size is not exposed by the Docker API on this host; host root filesystem is on the Host panel.)"
    },
    {
      "type": "timeseries",
      "title": "Container Network Traffic",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by(container_name) (rate(docker_container_net_rx_bytes{job=\"telegraf\",container_name=~\"$container\"}[2m]))",
          "legendFormat": "receive {{container_name}}",
          "refId": "A"
        },
        {
          "expr": "sum by(container_name) (rate(docker_container_net_tx_bytes{job=\"telegraf\",container_name=~\"$container\"}[2m]))",
          "legendFormat": "transmit {{container_name}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        }
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "container",
        "label": "Container",
        "type": "query",
        "datasource": "Prometheus",
        "definition": "label_values(docker_container_mem_usage, container_name)",
        "query": {
          "query": "label_values(docker_container_mem_usage, container_name)",
          "refId": "PrometheusVariableQuery"
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 1,
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "15s",
  "annotations": {
    "list": []
  }
}